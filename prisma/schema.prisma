generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// NOTE: "store" is its own microservice here. `userId` on Store is the seller's
// user id owned by the auth/user service — kept as a plain scalar (no Prisma
// relation) since there is no cross-service foreign key / join across DBs.
// Same reasoning applies wherever a future model needs to point at a user.
// ---------------------------------------------------------------------------

model CategorySpec {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid

  key        String
  name       String
  type       SpecType

  required   Boolean  @default(false)
  filterable Boolean  @default(false)
  searchable Boolean  @default(false)

  options    Json?

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([categoryId, key])
  @@index(categoryId)
  @@map("category_specs")
}

enum SpecType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum BusinessType {
  individual
  company
}

enum ReturnShippingPayer {
  seller_if_defective
  always_seller
  always_buyer
}

model SellerShippingSettings {
  storeId              String              @id @map("store_id")
  zone1                Decimal             @default(0) @db.Decimal(12, 2)
  zone2                Decimal             @default(0) @db.Decimal(12, 2)
  zone3                Decimal             @default(0) @db.Decimal(12, 2)
  freeShippingThreshold Decimal?            @map("free_shipping_threshold") @db.Decimal(12, 2)
  processingHours      Int                 @default(0) @map("processing_hours")
  returnWindowDays     Int                 @default(0) @map("return_window_days")
  returnShippingPayer  ReturnShippingPayer @default(seller_if_defective) @map("return_shipping_payer")

  store                Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("seller_shipping_settings")
}
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  specs     CategorySpec[]

  @@index(parentId, map: "idx_categories_parent")
  @@index(isActive, map: "idx_categories_active")
  @@map("categories")
}

model Store {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  name           String
  slug           String   @unique @db.VarChar(150)
  logoUrl        String?  @map("logo_url")
  coverUrl       String?  @map("cover_url")
  verified       Boolean  @default(false)
  rating         Decimal  @default(0) @db.Decimal(3, 2)
  reviewsCount   Int      @default(0) @map("reviews_count")
  productsCount  Int      @default(0) @map("products_count")
  location       String
  followersCount Int      @default(0) @map("followers_count")
  description    String?
  phone          String  @db.VarChar(30)
  email          String  @db.VarChar(255)
  website        String?
  businessType   BusinessType @map("business_type")
  vacationMode   Boolean  @default(false) @map("vacation_mode")
  businessHours Json @default("{\"monday\":{\"open\":\"08:00\",\"close\":\"16:00\",\"closed\":false},\"tuesday\":{\"open\":\"08:00\",\"close\":\"16:00\",\"closed\":false},\"wednesday\":{\"open\":\"08:00\",\"close\":\"16:00\",\"closed\":false},\"thursday\":{\"open\":\"08:00\",\"close\":\"16:00\",\"closed\":false},\"friday\":{\"open\":\"08:00\",\"close\":\"16:00\",\"closed\":false},\"saturday\":{\"open\":\"08:00\",\"close\":\"16:00\",\"closed\":false},\"sunday\":{\"open\":\"08:00\",\"close\":\"16:00\",\"closed\":false}}") @map("business_hours")
  socialLinks    Json     @default("{}") @map("social_links")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  policy StorePolicy?
  followers StoreFollower[]
  featured FeaturedStore[]
  shippingSettings SellerShippingSettings?
  @@index([verified, location], map: "idx_stores_verified_location")
  @@map("stores")
}
model FeaturedStore {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  position  Int       @default(0)
  startsAt  DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([position])
  @@index([startsAt, endsAt])
  @@map("featured_stores")
}

model StorePolicy {
  storeId            String   @id @map("store_id") @db.Uuid
  returnPolicy       String   @map("return_policy")
  refundPolicy       String   @map("refund_policy")
  cancellationPolicy String   @map("cancellation_policy")
  privacyPolicy      String   @map("privacy_policy")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_policies")
}

model StoreFollower {
  storeId    String   @map("store_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_followers")
}
